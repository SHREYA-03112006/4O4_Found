# ==========================================
# 4O4 FOUND — Environment Variables Template
# ==========================================

# Environment Mode
DEV_MODE=true
APP_ENV=development

# Application Secrets (generate a secure random 32+ character string in production)
JWT_SECRET=your_jwt_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Default fallback uses SQLite: sqlite:///./404_found.db
# For production PostgreSQL + pgvector:
# DATABASE_URL=postgresql://user:password@localhost:5432/found_db

# Redis Configuration (Optional for caching and fast vector indexing)
# REDIS_URL=redis://localhost:6379/0

# AI / Machine Learning Tokens
# Hugging Face Inference API token (for CLIP embeddings, BLIP captioning, DETR object detection)
HF_API_TOKEN=your_huggingface_api_token_here

# Google Gemini API Key (optional for LLM-assisted verification and smart queries)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Organization / Storage Settings
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10
